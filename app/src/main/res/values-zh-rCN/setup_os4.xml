<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="setup_os4_welcome_title">你的桌面，由你定义</string>
    <string name="setup_os4_welcome_body">从图标到桌面，按喜好一步步设置。</string>
    <string name="setup_os4_framework_title">先让模块准备好</string>
    <string name="setup_os4_framework_body">在 LSPosed 中启用 KeiHome、授权宿主作用域；首次使用还需要重启系统。也可以先继续，稍后完成。</string>
    <string name="setup_os4_icons_title">选一套喜欢的图标</string>
    <string name="setup_os4_icons_body">选择资源、预览效果，再生成并应用；下载或预览不会应用主题。</string>
    <string name="setup_os4_desktop_title">让桌面用起来顺手</string>
    <string name="setup_os4_desktop_body">从 Dock 质感、外观与文字、图标与启动中，按需调整。</string>
    <string name="setup_os4_finish_title">准备好，就出发</string>
    <string name="setup_os4_finish_body">未完成的步骤可以稍后完善，也能随时在设置中重新查看向导。</string>
    <string name="setup_os4_framework_manager">打开框架</string>
    <string name="setup_os4_scope">作用域授权</string>
    <string name="setup_os4_scope_body">查看宿主授权与版本，已授权不代表已加载</string>
    <string name="setup_os4_activation">首次启用必须完整重启设备。启用模块并授权作用域后，重启设备，解锁进入桌面后稍候。后续常规更新通常自动热重载；原生载荷变更可能需要另行重启。</string>
    <string name="setup_os4_icons_more">图标更多设置</string>
    <string name="setup_os4_desktop_dock">Dock 质感</string>
    <string name="setup_os4_desktop_appearance">外观与文字</string>
    <string name="setup_os4_desktop_launch">图标与启动</string>
    <string name="setup_os4_help">遇到问题</string>
    <string name="setup_os4_help_body">先查看状态页的运行状态与诊断 sheet，再按异常类型选择日志。反馈时附上版本、环境和复现步骤。</string>
    <string name="setup_os4_next">继续</string>
    <string name="setup_os4_start">开始设置</string>
    <string name="setup_os4_done">完成</string>
    <string name="setup_os4_scopes_granted">已授权 %1$d / %2$d</string>
    <string name="setup_os4_scopes_unknown">授权待确认</string>
    <string name="setup_os4_module_ready">框架已连接</string>
    <string name="setup_os4_module_pending">框架未连接</string>
    <string name="setup_os4_framework_action_summary">启用模块与管理作用域</string>
    <string name="setup_os4_icons_more_body">管理预览效果、生成包保留策略与状态卡直达当前图标包；最后一项默认开启。</string>
    <string name="setup_os4_desktop_note">按需调整后，在各分类查看生效状态。搜索栏质感可跟随 Dock，也可单独设置。</string>
    <string name="setup_os4_feature_icons">图标风格</string>
    <string name="setup_os4_feature_desktop">桌面定制</string>
    <string name="setup_os4_feature_control">按需启用</string>
    <string name="setup_os4_later">稍后</string>
    <string name="setup_os4_exit">退出</string>
</resources>
