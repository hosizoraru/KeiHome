# Loaded by name through META-INF/xposed/java_init.list. Keep this small module
# boundary stable across resident generations; ordinary implementation classes
# and the probe's private helpers can still be renamed and optimized.
-keep class os.kei.hyper.home.xposed.KeiHomeModule {
    *;
}

# Android instantiates these components from the manifest. The probe service
# is also bound by system_server from a different UID.
-keep,allowoptimization class os.kei.hyper.home.KeiHomeApplication {
    public <init>();
    public void onCreate();
}

-keep,allowoptimization class os.kei.hyper.home.MainActivity {
    public <init>();
    protected void onCreate(android.os.Bundle);
}

-keep,allowoptimization class os.kei.hyper.home.xposed.IconResourceProbeService {
    public <init>();
    public void onCreate();
    public android.os.IBinder onBind(android.content.Intent);
    public void onDestroy();
}

# NLS constructs this bundle reflectively, then uses its class and field names
# to load JGitText.properties and assign translated strings.
-keep,allowoptimization class org.eclipse.jgit.internal.JGitText {
    public <init>();
    public java.lang.String *;
}

# JGit's desktop JMX monitor has no Android runtime. The source store uses DFS;
# also fold off the file-cache monitoring switch in the optimized build.
-assumevalues class org.eclipse.jgit.storage.file.WindowCacheConfig {
    public boolean getExposeStatsViaJmx() return false;
}
-dontwarn java.lang.management.ManagementFactory
-dontwarn javax.management.InstanceAlreadyExistsException
-dontwarn javax.management.InstanceNotFoundException
-dontwarn javax.management.JMException
-dontwarn javax.management.MBeanRegistrationException
-dontwarn javax.management.MBeanServer
-dontwarn javax.management.MalformedObjectNameException
-dontwarn javax.management.NotCompliantMBeanException
-dontwarn javax.management.ObjectInstance
-dontwarn javax.management.ObjectName

# Anonymous transport rejects HTTP 401/407 before JGit authentication selection.
# Kerberos/SPNEGO is consequently unreachable and is not provided on Android.
-dontwarn org.ietf.jgss.GSSContext
-dontwarn org.ietf.jgss.GSSCredential
-dontwarn org.ietf.jgss.GSSException
-dontwarn org.ietf.jgss.GSSManager
-dontwarn org.ietf.jgss.GSSName
-dontwarn org.ietf.jgss.Oid
